{
  "name": "strapi-plugin-prompt-editor",
  "version": "2.0.0",
  "description": "This editor is capable of integrating with AI, enhancing your writing and editing experience.",
  "keywords": [
    "strapi",
    "plugin",
    "richeditor",
    "chatgpt",
    "gemini",
    "llm"
  ],
  "license": "MIT",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "test:ts:back": "run -T tsc -p server/tsconfig.json",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "verify": "strapi-plugin verify",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link"
  },
  "dependencies": {
    "@blocknote/core": "^0.31.3",
    "@blocknote/mantine": "^0.31.3",
    "@blocknote/react": "^0.31.3",
    "@google/generative-ai": "^0.24.1",
    "@strapi/design-system": "^2.0.0-rc.27",
    "@strapi/icons": "^2.0.0-rc.27",
    "chatgpt": "^5.2.5",
    "marked": "^15.0.12",
    "motion": "^12.18.1",
    "react": "^18.3.1",
    "react-intl": "^7.1.11"
  },
  "devDependencies": {
    "webdriverio": "^9.16.2"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.16.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "prompt-editor",
    "displayName": "Prompt Editor",
    "description": "A stylish editor enhanced by AI integration with Strapi."
  },
  "author": {
    "name": "yasudacloud",
    "url": "https://github.com/yasudacloud/strapi-plugin-prompt-editor"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yasudacloud/strapi-plugin-prompt-editor"
  },
  "bugs": {
    "url": "https://github.com/yasudacloud/strapi-plugin-prompt-editor/issues"
  },
  "maintainers": [
    {
      "name": "yasudacloud"
    }
  ]
}
